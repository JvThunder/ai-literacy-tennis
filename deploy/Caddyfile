tennis-ai.jvthunder.it.com {
	encode zstd gzip

	# Next.js app (systemd unit is generated by scripts/deploy.sh)
	reverse_proxy 127.0.0.1:3000

	# allow larger clip uploads
	request_body {
		max_size 80MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
