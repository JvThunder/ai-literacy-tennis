# Copy to .env and fill in (never commit .env). Read by backend/config.py, docker compose and the systemd unit.

# api = CPU server: precomputed cases + live answers from a hosted LLM (default)
# gpu = live uploads run MiniLM/FAISS/cross-encoder + local Qwen2.5-3B on CUDA (needs requirements-gpu.txt)
TENNIS_MODE=api

# api mode: OpenRouter key (https://openrouter.ai/keys). Set a credit limit on the key; the site is public.
OPENROUTER_API_KEY=
# (OPENROUTER_KEY is accepted too)
# Any OpenRouter model id. Default chosen on /eval (11 cheap models compared): ~1 s and ~$0.12 per 1,000 answers.
# Cheapest good alternative: qwen/qwen3.7-flash (~$0.04 per 1,000, ~3 s).
LLM_MODEL=google/gemini-2.5-flash-lite
# Max LLM-answered questions per uploaded clip (answers are cached)
MAX_QUESTIONS_PER_CLIP=20

# Code coaches type to submit a review on /eval (reviews are off when empty)
REVIEW_CODE=
